{
  "name": "Weather-app.com",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "author": {
    "name": "Shubham Oulkar",
    "email": "oulkarshubhu@gmail.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:app": "pnpm run build",
    "build:api": "tsc --project tsconfig.api.json",
    "vercel:build": "pnpm run build:app && pnpm run build:api",
    "preview": "pnpm run build && vite preview",
    "test": "vitest --ui",
    "test:ci": "vitest run --coverage",
    "test:preview": "vite preview --outDir html",
    "format:lint": "biome check --staged --write /",
    "format": "biome format --write ./src",
    "lint": "biome lint ./src",
    "clean:ci": "biome ci ./src",
    "migrate:eslint": "biome migrate eslint --write",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/google": "^2.0.51",
    "@ai-sdk/react": "^2.0.118",
    "@tanstack/react-query": "^5.90.14",
    "ai": "^5.0.116",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-share": "^5.2.2",
    "satori": "^0.18.3",
    "sharp": "^0.34.5",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.6",
    "@codecov/vite-plugin": "^1.9.1",
    "@eslint/js": "^9.38.0",
    "@tanstack/eslint-plugin-query": "^5.91.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/react-speech-recognition": "^3.9.6",
    "@vercel/node": "^5.4.1",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "^3.2.4",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.1",
    "openmeteo": "^1.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.11",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.20.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=v25.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "10.20.0",
      "onFail": "error"
    }
  }
}
